#!/usr/bin/env python3
import sys
import os
import logging
import time
import re

from asterisk.test_case import TestCase
LOGGER = logging.getLogger(__name__)

import signal
import subprocess
from twisted.internet import reactor

class RTTIdlePacketTest(TestCase):

    def __init__(self):
        super(RTTIdlePacketTest, self).__init__()
        self.reactor_timeout = 60
        self.create_asterisk(count=1)
        self.ast[0].all_out = True
        self.pjsua_rx = None
        self.pjsua_tx = None
        
        # Idle packet verification parameters
        self.idle_wait_seconds = 12
        self.min_expected_idle_packets = 2

    def run(self):
        super(RTTIdlePacketTest, self).run()
        LOGGER.info("Starting Asterisk for Idle Packet Test...")
        # Enable RTP debugging so Asterisk logs incoming/outgoing RTP packets
        self.ast[0].cli_exec("rtp set debug on")
        self.ast[0].cli_exec("pjsip set logger on")
        reactor.callLater(3, self.start_pjsua)

    def start_pjsua(self):
        LOGGER.info("Starting pjsua instances...")
        common_params = [
            '--no-tcp', '--text', '--text-red=2', '--no-vad',
            '--log-level=3', '--app-log-level=3',
            '--dis-codec=all', '--add-codec=red', '--add-codec=t140',
            '--null-audio'
        ]

        # Receiver (102)
        self.pjsua_rx = subprocess.Popen([
            '/usr/src/pjproject/pjsip-apps/bin/pjsua-x86_64-pc-linux-gnu',
            '--id=sip:102@127.0.0.1',
            '--ip-addr=127.0.0.1',
            '--local-port=5066',
            '--rtp-port=40000',
            '--outbound=sip:127.0.0.1:5060',
            '--auto-answer=200'
        ] + common_params, stdin=subprocess.PIPE,
                           stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT)

        # Caller (101)
        self.pjsua_tx = subprocess.Popen([
            '/usr/src/pjproject/pjsip-apps/bin/pjsua-x86_64-pc-linux-gnu',
            '--id=sip:101@127.0.0.1',
            '--ip-addr=127.0.0.1',
            '--local-port=5065',
            '--rtp-port=30000',
            '--outbound=sip:127.0.0.1:5060'
        ] + common_params, stdin=subprocess.PIPE,
                           stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT)

        reactor.callLater(3, self.make_call)

    def make_call(self):
        LOGGER.info("pjsua_tx: Dialing 102...")
        self.pjsua_tx.stdin.write(b"\n")
        self.pjsua_tx.stdin.write(b"m\n")
        self.pjsua_tx.stdin.write(b"sip:102@127.0.0.1:5060\n")
        self.pjsua_tx.stdin.flush()
        
        # Give call time to establish, then start initial text stream
        reactor.callLater(3, self.trigger_initial_text)

    def trigger_initial_text(self):
        LOGGER.info("Sending initial character to kick off text stream...")
        self.pjsua_tx.stdin.write(b"rt\n")
        self.pjsua_tx.stdin.flush()
        self.pjsua_tx.stdin.write(b"A\n")
        self.pjsua_tx.stdin.flush()

        # Now go idle for 6 seconds to let idle packets flow
        LOGGER.info(f"Going silent for {self.idle_wait_seconds}s to measure idle packets.[1]..")
        reactor.callLater(self.idle_wait_seconds, self.trigger_response)

    def trigger_response(self):
        self.pjsua_rx.stdin.write(b"rt\n")
        self.pjsua_rx.stdin.flush()
        self.pjsua_rx.stdin.write(b"B\n")
        self.pjsua_rx.stdin.flush()
        LOGGER.info(f"Going silent for {self.idle_wait_seconds}s to measure idle packets.[2]..")
        reactor.callLater(self.idle_wait_seconds, self.finish)

    def finish(self):
        LOGGER.info("Finishing test and analyzing Asterisk RTP logs...")

        # Gracefully quit pjsua instances
        for p in [self.pjsua_tx, self.pjsua_rx]:
            if p and p.stdin:
                try:
                    p.stdin.write(b"q\n")
                    p.stdin.flush()
                except (BrokenPipeError, OSError):
                    pass

        self.stop_reactor()

        ast_log = ""

        # Asterisk testsuite puts a hash in the directory so remove it
        base_dir = re.sub(r"/[a-f0-9]{32}/", "/rtt/rtt_red_t140_audio_idlepackets/", self.ast[0].base)
        log_file_path = os.path.join(base_dir, "var/log/asterisk/full.txt")
        #/tmp/asterisk-testsuite/rtt/rtt_red_t140_audio_idlepackets/run_2/ast1/var/log/asterisk/
        if os.path.exists(log_file_path):
            with open(log_file_path, "r", errors="ignore") as f:
                ast_log = f.read()
        else:
            # Fallback to checking the test output directory
            LOGGER.warning(
            f"Log file at {log_file_path} not found; checking test dir stdout."
        )

        # Count RTP packets sent/received on text ports
        rtp_sent_received = len(re.findall(r'Writing text idle packet', ast_log))
        

        print("\n" + "="*50)
        print(f"--- IDLE PACKET TEST RESULTS ---")
        print(f"RTP Packets SENT/ Received : {rtp_sent_received}")
        
        print("="*50 + "\n")

        if rtp_sent_received >= self.min_expected_idle_packets:
            LOGGER.info(f"SUCCESS: Received {rtp_sent_received} idle RTP packets (Threshold >= {self.min_expected_idle_packets})!")
            self.passed = True
        else:
            LOGGER.error(f"FAILURE: Only received {rtp_sent_received} idle RTP packets! (Expected >= {self.min_expected_idle_packets})")
            if ast_log:
                print(f"DEBUG: Asterisk Log Excerpt:\n{ast_log[-2000:]}")
            self.passed = False

    def stop_reactor(self):
        for p in [self.pjsua_rx, self.pjsua_tx]:
            if p:
                try:
                    os.kill(p.pid, signal.SIGKILL)
                except OSError:
                    pass
        super(RTTIdlePacketTest, self).stop_reactor()


def main():
    test = RTTIdlePacketTest()
    reactor.run()
    return 0 if test.passed else 1

if __name__ == "__main__":
    sys.exit(main() or 0)