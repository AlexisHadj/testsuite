import pjsua as pj
class Python3CompatiblePjsuaError(Exception):
    def __init__(self, op_name, obj, err_code, err_msg=""):
        super().__init__(f"Object: {obj}, operation={op_name}, error={err_msg} ({err_code})")
        self.op_name = op_name
        self.obj = obj
        self.err_code = err_code
        self._err_msg = err_msg

    def err_msg(self):
        return self._err_msg

pj.Error = Python3CompatiblePjsuaError
import _pjsua

