        self.send_rtt_payload(self.rx_call, wakeup_txt)
    
    def step_de_im(self):
        call_id = self.tx_call._id
        msg_data = pj.Lib._create_msg_data(None)
        err = _pjsua.call_send_im(call_id, "text/plain", de_txt, msg_data, 0)

        print("101 wrote 'German'...")
        print(f"--- RESPONSE RECEIVED! Status Code: {err} ---")
        LOGGER.info(f"--- RESPONSE RECEIVED! Status Code: {err} ---")

        if err == 0:
            print("SUCCESS! _pjsua.call_send_im completed with PJ_SUCCESS (0).")
        else:
            print(f"Returned error state: {err}")

        reactor.callLater(2, self.step_cn)

    def step_cn(self):        
        print("102 writing 'Chinese'...")
        LOGGER.info(f"102 writing 'Chinese'...")
        self.send_rtt_payload(self.rx_call, cn_txt)
        reactor.callLater(2, self.step_am)

    def step_am(self):
        print("101 writing 'Armenian'...")
        LOGGER.info(f"101 writing 'Armenian'...")
        self.send_rtt_payload(self.tx_call, am_txt)
        reactor.callLater(2, self.step_hi)

    def step_hi(self):
        print("102 writing 'Hindi'...")
        LOGGER.info(f"102 writing 'Hindi'...")
        self.send_rtt_payload(self.rx_call, hi_txt)
        reactor.callLater(2, self.finish)


    def finish(self):
        global TX_LOG_BUFFER, RX_LOG_BUFFER
        LOGGER.info("Verifying message exchange...")
        print("Verifying message exchange...")

        # Write out our captured  text results for local troubleshooting verification
        with open("/tmp/full_pjsua_output.log", "w", encoding='utf-8') as f:
            f.write("========== TX OUTPUT (101) ==========\n")
            f.write(TX_LOG_BUFFER)
            f.write("\n\n========== RX OUTPUT (102) ==========\n")
            f.write(RX_LOG_BUFFER)

        self.stop_reactor()

        # Validate our localized memory strings populated dynamically during call loop execution
        rx_saw_english = "Incoming text" in RX_LOG_BUFFER and en_txt in RX_LOG_BUFFER
        tx_saw_greek = "Incoming text" in TX_LOG_BUFFER and gr_txt in TX_LOG_BUFFER
        rx_saw_german = "Incoming text" in RX_LOG_BUFFER and de_txt in RX_LOG_BUFFER
        tx_saw_chinese = "Incoming text" in TX_LOG_BUFFER and cn_txt in TX_LOG_BUFFER
        rx_saw_armenian = "Incoming text" in RX_LOG_BUFFER and am_txt in RX_LOG_BUFFER
        tx_saw_hindi = "Incoming text" in TX_LOG_BUFFER and hi_txt in TX_LOG_BUFFER

        if rx_saw_english and tx_saw_greek and rx_saw_german and tx_saw_chinese and rx_saw_armenian and tx_saw_hindi:
            LOGGER.info("SUCCESS: RTT exchange confirmed via native engine wrapper state evaluation!")
            print("SUCCESS.")
            self.passed = True
        else:
            if not rx_saw_english: LOGGER.error("FAILURE: 102 (Receiver) never saw 'English'")
            if not tx_saw_greek:   LOGGER.error("FAILURE: 101 (Caller) never saw 'Greek'")
            if not rx_saw_german:  LOGGER.error("FAILURE: 102 (Receiver) never saw 'German'")
            if not tx_saw_chinese: LOGGER.error("FAILURE: 101 (Caller) never saw 'Chinese'")
            if not rx_saw_armenian: LOGGER.error("FAILURE: 102 (Receiver) never saw 'Armenian'")
            if not tx_saw_hindi:    LOGGER.error("FAILURE: 101 (Caller) never saw 'Hindi'")
            self.passed = False

    def stop_reactor(self):
        # Gracefully teardown and destroy the library execution processes mapping
        #try:
        #    if self.tx_lib:
        #        self.tx_lib.destroy()
        #    if self.rx_lib:
        #        self.rx_lib.destroy()
        #except Exception:
        #    pass
        #super(SRTPTest, self).stop_reactor()
        print("--- Teardown: Stopping PJSUA Poller and Destroying PJSIP Engine ---")
        LOGGER.info("Teardown: Stopping PJSUA Poller and Destroying PJSIP Engine")

        try:
            if hasattr(self, 'pjsua_poller') and self.pjsua_poller.running:
                self.pjsua_poller.stop()
        except Exception as e:
            LOGGER.error(f"Error stopping poller: {e}")

        try:
            if hasattr(self, 'lib') and self.lib:
                # Disconnect any calls before destroying to prevent hanging threads
                if hasattr(self, 'tx_call') and self.tx_call:
                    self.tx_call.hangup()
                if hasattr(self, 'rx_call') and self.rx_call:
                    self.rx_call.hangup()

                self.lib.destroy()
                self.lib = None
        except Exception as e:
            LOGGER.error(f"Error destroying PJSIP library: {e}")

        # 3. Hand over control to the Asterisk Test Suite TestCase class to clean up the rest
        super(SRTPTest, self).stop_reactor()


def main():
    test = SRTPTest()
    reactor.run()
    return 0 if test.passed else 1

if __name__ == "__main__":
    sys.exit(main() or 0)